{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"Lotus_house welcome home."},{"location":"Singforme/","title":"\u4e0d\u53ef\u8bf4","text":"<p>\u4e0d\u53ef\u8bf4\u5c31\u5531\u51fa\u6765\u3002</p>"},{"location":"Singforme/#n00","title":"N0.0 \u523a\u9752","text":"<p>\u6d53\u6de1 \u8096\u50cf\u4e24\u8272\u8868\u73b0 \u5eb8\u51e1 \u96d5\u7422\u5c3d\u5fc3\u4f9d\u7136 \u50b2\u6162 \u662f\u8352\u829c\u8513\u751f\u7684 \u8c0e\u8a00 \u65e0\u4eba\u53bb\u63ed\u7a7f</p> <p>\u88c5\u70b9 \u6ce1\u6cab\u5347\u817e\u77ac\u95f4 \u4f53\u9762 \u6211\u4e0e\u6211\u4e45\u5468\u65cb \u6563\u573a \u7559\u4e0d\u4f4f\u5929\u8272\u665a \u4e0d\u5b89 \u6795\u4e0a\u7684\u8f97\u8f6c</p> <p>\u5173\u95ed\u654f\u611f \u6c89\u6ca6\u949d\u611f \u591a\u5c11\u65f6\u95f4\u591f\u6211\u964d\u89e3\u75db\u611f \u6323\u624e\u65e0\u7720 \u75c7\u72b6\u65e0\u8a00 \u6e7f\u51b7\u7684\u6cea\u8def\u8fc7\u4e4c\u9752\u773c\u5708</p> <p>\uff08\u4f60\u5f3a\u52a0\uff09</p> <p>\u7a92\u606f\u6df7\u70b9\u5173\u5fc3 \u5212\u7834\u5589\u5499\u541e\u54bd \u5fc3\u5e95\u9690\u75db\u53d1\u4f5c \u6495\u88c2\u5168\u90e8\u660e\u5929</p> <p>\u5e73\u4ec4 \u4e00\u8d77\u4e00\u843d\u5343\u4e08 \u82ac\u82b3 \u6298\u53e0\u8d77\u6765\u6536\u85cf \u6c64\u6c64 \u901d\u6c34\u81ea\u987e\u81ea\u6dcc \u7834\u788e  \u672c\u65e0\u4eba\u6b23\u8d4f</p> <p>\u7f8e\u662f\u8096\u60f3 \u7231\u662f\u5984\u60f3 \u85d5\u65ad\u4e1d\u8fde\u4e0d\u613f\u62bd\u5e72\u5ff5\u60f3 \u9003\u907f\u76ee\u5149 \u81f4\u6b49\u5938\u5956 \u6015\u671f\u5f85\u843d\u7a7a\u7cd6\u600e\u6562\u53bb\u62a2</p> <p>\uff08\u4f60\u7ed9\u7684\uff09</p> <p>\u5fc3\u4f24\u662f\u9053\u523a\u9752 \u6d41\u8fc7\u8840\u7684\u98ce\u666f \u6d17\u6389\u8981\u5fcd\u7740\u75db \u70d9\u5370\u53bb\u4e0d\u5e72\u51c0</p> <p>\u5316\u6210\u7070\u70e7\u5e72\u51c0</p>"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u8fd9\u91cc\u662f Lotus\u3002</p> <p>\u76ee\u524d\u53ea\u662f\u4e2a\u6709\u70b9\u5fe7\u90c1\u7684\u5c0f\u5973\u5b69\u3002</p> <p>\u672c\u7ad9\u4e3b\u8981\u7528\u4e8e\u5b58\u653e\u4e00\u4e9b\u4e2a\u4eba\u521b\u4f5c\u7684\u6b4c\u8bcd\uff0c\u671f\u5f85\u6709\u671d\u4e00\u65e5\u80fd\u4e3a\u5979\u4eec\u4f5c\u66f2\u3002\u4e5f\u4f1a\u968f\u673a\u6389\u843d\u4e00\u4e9b\u751f\u6d3b\u611f\u53d7/\u89c2\u70b9\u3002</p> <p>\u5982\u65e0\u610f\u5916\uff0c\u53ea\u6709\u6211\u4e00\u4e2a\u4eba\u4f1a\u6ce8\u610f\u5230\u8fd9\u91cc\u3002</p>"},{"location":"course/","title":"\u8bfe\u7a0b","text":"<p>\u8fd9\u91cc\u4f1a\u6574\u7406\u6211\u5b66\u4e60\u548c\u8f93\u51fa\u7684\u8bfe\u7a0b\u7b14\u8bb0\uff0c\u65b9\u4fbf\u4ee5\u540e\u6309\u4e3b\u9898\u67e5\u627e\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li> <p>\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863</p> </li> <li> <p>\u4f46\u662f\uff0c\u6211\u5e76\u6ca1\u6253\u7b97\u628a\u8fd9\u4e2a\u7f51\u7ad9\u7528\u4e8e\u5206\u4eab\u4e13\u4e1a\u8bfe\u7a0b\u2014\u2014\u6211\u7684\u6c34\u5e73\u786e\u5b9e\u6ca1\u5230\u5206\u4eab\u7684\u7a0b\u5ea6\u5440\uff01</p> </li> </ul>"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863","text":"<p>\u8fd9\u662f\u4e00\u7bc7\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863\u3002\u4ee5\u540e\u65b0\u589e\u8bfe\u7a0b\u6587\u7ae0\u65f6\uff0c\u53ef\u4ee5\u53c2\u8003\u4e0b\u9762\u7684\u7ed3\u6784\u6765\u5199\u3002</p>"},{"location":"course/example/#_2","title":"\u8bfe\u7a0b\u4fe1\u606f","text":"<ul> <li>\u8bfe\u7a0b\u540d\u79f0\uff1a\u793a\u4f8b\u8bfe\u7a0b</li> <li>\u5b66\u4e60\u65f6\u95f4\uff1a2026-08-08</li> <li>\u9002\u5408\u4eba\u7fa4\uff1a\u521a\u5f00\u59cb\u6574\u7406\u7b14\u8bb0\u7684\u4eba</li> </ul>"},{"location":"course/example/#_3","title":"\u5b66\u4e60\u76ee\u6807","text":"<p>\u5b66\u5b8c\u8fd9\u7bc7\u6587\u7ae0\u540e\uff0c\u6211\u5e0c\u671b\u81ea\u5df1\u80fd\u591f\uff1a</p> <ul> <li>\u7406\u89e3\u8fd9\u4e2a\u4e3b\u9898\u7684\u6838\u5fc3\u6982\u5ff5</li> <li>\u8bb0\u5f55\u91cd\u8981\u6b65\u9aa4\u548c\u6ce8\u610f\u4e8b\u9879</li> <li>\u603b\u7ed3\u81ea\u5df1\u7684\u6536\u83b7</li> </ul>"},{"location":"course/example/#_4","title":"\u6b63\u6587\u5185\u5bb9","text":"<p>\u8fd9\u91cc\u5199\u8bfe\u7a0b\u7684\u4e3b\u8981\u5185\u5bb9\u3002\u53ef\u4ee5\u6309\u5c0f\u6807\u9898\u62c6\u5206\uff0c\u907f\u514d\u4e00\u6574\u7bc7\u592a\u957f\u4e0d\u597d\u9605\u8bfb\u3002</p>"},{"location":"course/example/#_5","title":"\u5c0f\u8282\u6807\u9898","text":"<p>\u8fd9\u91cc\u5199\u67d0\u4e2a\u77e5\u8bc6\u70b9\u7684\u8bf4\u660e\u3002</p>"},{"location":"course/example/#_6","title":"\u603b\u7ed3","text":"<p>\u8fd9\u91cc\u5199\u672c\u7bc7\u8bfe\u7a0b\u7684\u91cd\u70b9\u56de\u987e\uff0c\u4ee5\u53ca\u540e\u7eed\u8fd8\u9700\u8981\u7ee7\u7eed\u5b66\u4e60\u7684\u5185\u5bb9\u3002</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u8fd9\u91cc\u4f1a\u653e\u6211\u5e38\u8bbf\u95ee\u7684\u7f51\u7ad9\u548c\u670b\u53cb\u4eec\u7684\u7f51\u7ad9\u3002</p> <ul> <li>MkDocs \u5b98\u7f51</li> <li>Material for MkDocs</li> </ul>"}]}