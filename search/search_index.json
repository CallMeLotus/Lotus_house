{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"Lotus_house          welcome home."},{"location":"#_1","title":"\u4e3b\u9875","text":""},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u4f60\u597d\uff0c\u8fd9\u91cc\u662f Lotus\u3002</p> <p>\u76ee\u524d\u53ea\u662f\u4e2a\u6709\u70b9\u5fe7\u90c1\u7684\u5c0f\u5973\u5b69\u3002</p> <p>\u672c\u7ad9\u4e3b\u8981\u7528\u4e8e\u5b58\u653e\u4e00\u4e9b\u4e2a\u4eba\u521b\u4f5c\u7684\u6b4c\u8bcd\uff0c\u671f\u5f85\u6709\u671d\u4e00\u65e5\u80fd\u4e3a\u5979\u4eec\u4f5c\u66f2\u3002\u4e5f\u4f1a\u968f\u673a\u6389\u843d\u4e00\u4e9b\u751f\u6d3b\u611f\u53d7/\u89c2\u70b9\u3002</p> <p>\u5982\u65e0\u610f\u5916\uff0c\u53ea\u6709\u6211\u4e00\u4e2a\u4eba\u4f1a\u6ce8\u610f\u5230\u8fd9\u91cc\u3002</p>"},{"location":"course/","title":"\u8bfe\u7a0b","text":"<p>\u8fd9\u91cc\u4f1a\u6574\u7406\u6211\u5b66\u4e60\u548c\u8f93\u51fa\u7684\u8bfe\u7a0b\u7b14\u8bb0\uff0c\u65b9\u4fbf\u4ee5\u540e\u6309\u4e3b\u9898\u67e5\u627e\u3002</p>"},{"location":"course/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li> <p>\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863</p> </li> <li> <p>\u4f46\u662f\uff0c\u6211\u5e76\u6ca1\u6253\u7b97\u628a\u8fd9\u4e2a\u7f51\u7ad9\u7528\u4e8e\u5206\u4eab\u4e13\u4e1a\u8bfe\u7a0b\u2014\u2014\u6211\u7684\u6c34\u5e73\u786e\u5b9e\u6ca1\u5230\u5206\u4eab\u7684\u7a0b\u5ea6\u5440\uff01</p> </li> </ul>"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863","text":"<p>\u8fd9\u662f\u4e00\u7bc7\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863\u3002\u4ee5\u540e\u65b0\u589e\u8bfe\u7a0b\u6587\u7ae0\u65f6\uff0c\u53ef\u4ee5\u53c2\u8003\u4e0b\u9762\u7684\u7ed3\u6784\u6765\u5199\u3002</p>"},{"location":"course/example/#_2","title":"\u8bfe\u7a0b\u4fe1\u606f","text":"<ul> <li>\u8bfe\u7a0b\u540d\u79f0\uff1a\u793a\u4f8b\u8bfe\u7a0b</li> <li>\u5b66\u4e60\u65f6\u95f4\uff1a2026-08-08</li> <li>\u9002\u5408\u4eba\u7fa4\uff1a\u521a\u5f00\u59cb\u6574\u7406\u7b14\u8bb0\u7684\u4eba</li> </ul>"},{"location":"course/example/#_3","title":"\u5b66\u4e60\u76ee\u6807","text":"<p>\u5b66\u5b8c\u8fd9\u7bc7\u6587\u7ae0\u540e\uff0c\u6211\u5e0c\u671b\u81ea\u5df1\u80fd\u591f\uff1a</p> <ul> <li>\u7406\u89e3\u8fd9\u4e2a\u4e3b\u9898\u7684\u6838\u5fc3\u6982\u5ff5</li> <li>\u8bb0\u5f55\u91cd\u8981\u6b65\u9aa4\u548c\u6ce8\u610f\u4e8b\u9879</li> <li>\u603b\u7ed3\u81ea\u5df1\u7684\u6536\u83b7</li> </ul>"},{"location":"course/example/#_4","title":"\u6b63\u6587\u5185\u5bb9","text":"<p>\u8fd9\u91cc\u5199\u8bfe\u7a0b\u7684\u4e3b\u8981\u5185\u5bb9\u3002\u53ef\u4ee5\u6309\u5c0f\u6807\u9898\u62c6\u5206\uff0c\u907f\u514d\u4e00\u6574\u7bc7\u592a\u957f\u4e0d\u597d\u9605\u8bfb\u3002</p>"},{"location":"course/example/#_5","title":"\u5c0f\u8282\u6807\u9898","text":"<p>\u8fd9\u91cc\u5199\u67d0\u4e2a\u77e5\u8bc6\u70b9\u7684\u8bf4\u660e\u3002</p>"},{"location":"course/example/#_6","title":"\u603b\u7ed3","text":"<p>\u8fd9\u91cc\u5199\u672c\u7bc7\u8bfe\u7a0b\u7684\u91cd\u70b9\u56de\u987e\uff0c\u4ee5\u53ca\u540e\u7eed\u8fd8\u9700\u8981\u7ee7\u7eed\u5b66\u4e60\u7684\u5185\u5bb9\u3002</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u8fd9\u91cc\u4f1a\u653e\u6211\u5e38\u8bbf\u95ee\u7684\u7f51\u7ad9\u548c\u670b\u53cb\u4eec\u7684\u7f51\u7ad9\u3002</p> <ul> <li>MkDocs \u5b98\u7f51</li> <li>Material for MkDocs</li> </ul>"}]}